<Window x:Class="MoniHop.Desktop.WindowProjection.QuickProjectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷投放" Width="540" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" FontSize="15"
        PreviewKeyDown="QuickProjectionWindow_OnPreviewKeyDown">
    <Border Padding="22" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="快捷投放" />
                <TextBlock Margin="0,6,0,0" FontSize="13"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="选择目标显示器和窗口布局，然后按 Enter 投放。" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="目标显示器" />
                <ListBox x:Name="DisplayList" ItemsSource="{Binding Displays}"
                         SelectedItem="{Binding SelectedDisplay}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="142" Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="25" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Text="{Binding Number}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Style="{StaticResource SecondaryTextStyle}" Text="{Binding Resolution}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="窗口布局" />
                <ListBox x:Name="LayoutList" ItemsSource="{Binding Layouts}"
                         SelectedItem="{Binding SelectedLayout}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="102" Margin="8" HorizontalAlignment="Center">
                                <Grid Width="38" Height="28" HorizontalAlignment="Center">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" />
                                    <Border x:Name="LayoutFill" Margin="4" Background="{DynamicResource BrandSubtleBrush}" CornerRadius="1" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Layout}" Value="KeepSize">
                                    <Setter TargetName="LayoutFill" Property="Width" Value="20" />
                                    <Setter TargetName="LayoutFill" Property="Height" Value="14" />
                                    <Setter TargetName="LayoutFill" Property="HorizontalAlignment" Value="Center" />
                                    <Setter TargetName="LayoutFill" Property="VerticalAlignment" Value="Center" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Layout}" Value="LeftHalf">
                                    <Setter TargetName="LayoutFill" Property="Width" Value="14" />
                                    <Setter TargetName="LayoutFill" Property="HorizontalAlignment" Value="Left" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Layout}" Value="RightHalf">
                                    <Setter TargetName="LayoutFill" Property="Width" Value="14" />
                                    <Setter TargetName="LayoutFill" Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border x:Name="ErrorNotice" Grid.Row="3" Margin="0,16,0,0" Padding="10,8"
                    Background="{DynamicResource ErrorSubtleBrush}" CornerRadius="4" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" />
            </Border>

            <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="88" Padding="14,7" Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_OnClick" Content="取消" />
                <Button Margin="10,0,0,0" MinWidth="100" Padding="14,7"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ProjectButton_OnClick" Content="投放" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
