<Window x:Class="MoniHop.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniHop"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MoniHop"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#FF5A5A5A"
                       Text="已连接显示器" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="鼠标切屏" />
            <TextBlock Grid.Column="2"
                       Padding="8,4"
                       VerticalAlignment="Center"
                       Foreground="#FF444444"
                       Background="#FFEDEDED"
                       Text="Ctrl + Alt + M" />
            <TextBlock x:Name="HotKeyStatusText"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       Text="正在注册" />
        </Grid>

        <ListBox Grid.Row="4"
                 ItemsSource="{Binding Displays}"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#FF666666"
                                           Text="{Binding ResolutionText}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="#FF777777"
                                           FontSize="12"
                                           Text="{Binding DeviceName}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="8,4"
                                    Background="#FFE6F2EE"
                                    CornerRadius="4"
                                    Visibility="{Binding PrimaryVisibility}">
                                <TextBlock Foreground="{StaticResource AccentBrush}"
                                           FontSize="12"
                                           Text="主显示器" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
