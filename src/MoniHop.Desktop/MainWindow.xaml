<Window x:Class="MoniHop.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniHop"
        Icon="Assets/MoniHop.Window.ico"
        Width="1120" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox x:Name="BrandMark" Width="38" Height="28"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             Stretch="Uniform" IsHitTestVisible="False">
                        <Canvas x:Name="BrandMarkViewport" Width="744" Height="470" ClipToBounds="True">
                            <Canvas Width="1024" Height="1024" Canvas.Left="-140" Canvas.Top="-276">
                            <Path Data="M140 276H223L371 447L517 276H519V535H402V605H371L240 455V746H140Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#171A1F" />
                                        <GradientStop Offset="1" Color="#24282E" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M518 276H617V447H518Z M632 460H783V276H884V746H783V545H632Z M452 621H617V746H452Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#4A505A" />
                                        <GradientStop Offset="1" Color="#343840" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <Path Data="M536 462H632V545H610V605H416V552H536Z"
                                  Fill="{DynamicResource NavigationBackgroundBrush}"
                                  Stroke="{DynamicResource NavigationBackgroundBrush}"
                                  StrokeThickness="26" StrokeLineJoin="Miter" />
                            <Path Data="M536 462H632V545H610V605H416V552H536Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#0B63E6" />
                                        <GradientStop Offset="1" Color="#0B4FD7" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandTitleStyle}" Text="MoniHop"/>
                        <TextBlock Margin="0,1,0,0" Style="{StaticResource CaptionTextStyle}" Text="跃屏"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="NavigationList" Grid.Row="2" Style="{StaticResource NavigationListStyle}" SelectionChanged="NavigationList_OnSelectionChanged">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" Text="{Binding Icon}"/><TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" Text="{Binding Label}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="34,28,18,26" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
