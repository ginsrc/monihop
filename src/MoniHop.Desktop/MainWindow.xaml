<Window x:Class="MoniHop.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoniHop"
        Width="1120" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavigationBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,20,18,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock FontSize="24" FontWeight="SemiBold" Text="MoniHop"/><TextBlock Margin="0,2,0,0" Style="{StaticResource SecondaryTextStyle}" Text="跃屏"/></StackPanel>
                <ListBox x:Name="NavigationList" Grid.Row="2" Style="{StaticResource NavigationListStyle}" SelectionChanged="NavigationList_OnSelectionChanged">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" Text="{Binding Icon}"/><TextBlock Grid.Column="1" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" Text="{Binding Label}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Margin="2,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="0.1.0-alpha1"/>
            </Grid>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="34,28,18,26" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
