<UserControl x:Class="MoniHop.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于与诊断" />
        <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}" Text="查看程序版本、运行环境和本地文件位置。" />
        <Border Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="MoniHop（跃屏）" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Windows 11 多显示器本地窗口调度工具" />
            <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="版本"/><TextBlock Grid.Column="1" Text="0.1.0-alpha1"/></Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="许可证"/><TextBlock Grid.Column="1" Foreground="{StaticResource WarningBrush}" Text="待确定"/></Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Windows"/><TextBlock Grid.Column="1" Text="{Binding OperatingSystem}"/></Grid>
        </StackPanel></Border>
        <Border Margin="0,18,0,0" Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本地文件位置" />
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="执行目录"/><TextBlock Grid.Column="1" Text="{Binding ExecutableDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutableDirectory}"/></Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="数据目录"/><TextBlock Grid.Column="1" Text="{Binding DataDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}"/></Grid>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="配置目录"/><TextBlock Grid.Column="1" Text="{Binding ConfigurationDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationDirectory}"/></Grid>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
