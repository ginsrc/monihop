<UserControl x:Class="MoniHop.Desktop.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AboutIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="AboutLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Width" Value="132" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,4">
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="{DynamicResource String.About.Title}" />
                <TextBlock Margin="0,6,0,18"
                           Style="{StaticResource PageSubtitleStyle}"
                           Text="{DynamicResource String.About.Description}" />

                <Border Style="{StaticResource SurfaceSectionStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="MoniHop" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{DynamicResource String.About.Product.Tagline}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrandBrush}"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Text="{Binding Version}" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Product.LicenseLabel}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="MIT License · Copyright (c) 2026 ginsrc" />
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="ProjectButton"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource String.About.Product.Project}"
                                    Click="ProjectButton_OnClick" />
                            <Button x:Name="ReleasesButton"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource String.About.Product.Releases}"
                                    Click="ReleasesButton_OnClick" />
                            <Button x:Name="IssuesButton"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource String.About.Product.Issues}"
                                    Click="IssuesButton_OnClick" />
                            <Button x:Name="LicenseButton"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource String.About.Product.License}"
                                    Click="LicenseButton_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="{DynamicResource String.About.Update.Section}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{DynamicResource String.About.Update.Description}" />
                            </StackPanel>
                            <Button x:Name="CheckUpdatesButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource String.About.Update.Check}"
                                    Click="CheckUpdatesButton_OnClick" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource String.About.Update.Automatic}" />
                                <TextBlock Margin="0,3,18,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{DynamicResource String.About.Update.AutomaticDescription}" />
                            </StackPanel>
                            <CheckBox x:Name="AutomaticUpdateCheckToggle"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="AutomaticUpdateCheckToggle_OnClick" />
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Margin="0,3,18,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{DynamicResource String.About.Update.SecurityNote}" />
                            </StackPanel>
                            <Button x:Name="OpenUpdateButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource String.About.Update.OpenRelease}"
                                    Click="OpenUpdateButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{DynamicResource String.About.Diagnostics.Section}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{DynamicResource String.About.Diagnostics.Description}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.Windows}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding OperatingSystem}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OperatingSystem}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.Runtime}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       Text="{Binding Runtime}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Runtime}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.Architecture}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ProcessArchitecture}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.Identity}" />
                            <TextBlock x:Name="RunIdentityText" Grid.Column="3" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.Displays}" />
                            <TextBlock x:Name="ConnectedDisplayCountText" Grid.Column="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Diagnostics.LogSize}" />
                            <TextBlock x:Name="DiagnosticLogSizeText" Grid.Column="3" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{DynamicResource String.About.Diagnostics.Detailed}" />
                                <TextBlock Margin="0,3,18,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{DynamicResource String.About.Diagnostics.DetailedDescription}" />
                            </StackPanel>
                            <CheckBox x:Name="DetailedDiagnosticsToggle"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="DetailedDiagnosticsToggle_OnClick" />
                        </Grid>

                        <WrapPanel Margin="0,18,0,0">
                            <Button x:Name="ExportDiagnosticsButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{DynamicResource String.About.Diagnostics.Export}"
                                    Click="ExportDiagnosticsButton_OnClick" />
                            <Button x:Name="OpenDiagnosticsDirectoryButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource String.About.Diagnostics.OpenDirectory}"
                                    Click="OpenDiagnosticsDirectoryButton_OnClick" />
                            <Button x:Name="ClearDiagnosticsButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Content="{DynamicResource String.About.Diagnostics.Clear}"
                                    Click="ClearDiagnosticsButton_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="{DynamicResource String.About.Paths.Section}" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{DynamicResource String.About.Paths.Description}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Paths.Executable}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding ExecutableDirectory}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ExecutableDirectory}" />
                            <Button x:Name="CopyExecutableDirectoryButton" Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xE8C8;"
                                    ToolTip="{DynamicResource String.About.Paths.Copy}"
                                    Tag="{Binding ExecutableDirectory}" Click="CopyPathButton_OnClick" />
                            <Button x:Name="OpenExecutableDirectoryButton" Grid.Column="3"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xED25;"
                                    ToolTip="{DynamicResource String.About.Paths.Open}"
                                    Tag="{Binding ExecutableDirectory}" Click="OpenPathButton_OnClick" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Paths.Data}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding DataDirectory}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DataDirectory}" />
                            <Button x:Name="CopyDataDirectoryButton" Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xE8C8;"
                                    ToolTip="{DynamicResource String.About.Paths.Copy}"
                                    Tag="{Binding DataDirectory}" Click="CopyPathButton_OnClick" />
                            <Button x:Name="OpenDataDirectoryButton" Grid.Column="3"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xED25;"
                                    ToolTip="{DynamicResource String.About.Paths.Open}"
                                    Tag="{Binding DataDirectory}" Click="OpenPathButton_OnClick" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Paths.Configuration}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding ConfigurationDirectory}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ConfigurationDirectory}" />
                            <Button x:Name="CopyConfigurationDirectoryButton" Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xE8C8;"
                                    ToolTip="{DynamicResource String.About.Paths.Copy}"
                                    Tag="{Binding ConfigurationDirectory}" Click="CopyPathButton_OnClick" />
                            <Button x:Name="OpenConfigurationDirectoryButton" Grid.Column="3"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xED25;"
                                    ToolTip="{DynamicResource String.About.Paths.Open}"
                                    Tag="{Binding ConfigurationDirectory}" Click="OpenPathButton_OnClick" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource AboutLabelStyle}"
                                       Text="{DynamicResource String.About.Paths.Diagnostics}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding DiagnosticsDirectory}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DiagnosticsDirectory}" />
                            <Button x:Name="CopyDiagnosticsDirectoryButton" Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xE8C8;"
                                    ToolTip="{DynamicResource String.About.Paths.Copy}"
                                    Tag="{Binding DiagnosticsDirectory}" Click="CopyPathButton_OnClick" />
                            <Button x:Name="OpenDiagnosticsDirectoryIconButton" Grid.Column="3"
                                    Style="{StaticResource AboutIconButtonStyle}" Content="&#xED25;"
                                    ToolTip="{DynamicResource String.About.Paths.Open}"
                                    Tag="{Binding DiagnosticsDirectory}" Click="OpenPathButton_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ActionToast"
                Panel.ZIndex="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Padding="12,8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastIndicator"
                         Width="7" Height="7" Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBrush}" />
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
