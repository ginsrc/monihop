<Window x:Class="MoniHop.Desktop.Views.RunningApplicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择运行中的应用" Width="520" Height="430" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择运行中的应用" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}"
                   Text="仅显示可稳定识别且可移动的普通顶层窗口。" />
        <ListBox x:Name="ApplicationsList" Grid.Row="3" ItemsSource="{Binding Applications}"
                 DisplayMemberPath="DisplayName" MouseDoubleClick="ApplicationsList_OnMouseDoubleClick" />
        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="78" Margin="0,0,8,0" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="78" Content="选择" IsDefault="True" Click="Select_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
