<UserControl x:Class="MoniHop.Desktop.Views.HotKeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="HotKeysPage_OnPreviewKeyDown">
    <Grid>
        <ScrollViewer Focusable="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,16,0" MaxWidth="980">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="快捷键" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource PageSubtitleStyle}"
                                   Text="高频动作保留默认组合；未设置的动作不会注册全局快捷键。" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" Padding="12,6"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ResetDefaultsButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontFamily="Segoe Fluent Icons"
                                       FontSize="14" Text="&#xE777;" />
                            <TextBlock Text="恢复默认" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="CaptureNotice" Grid.Row="1" Margin="0,18,0,0" Padding="12,9"
                        Background="{DynamicResource BrandSubtleBrush}" CornerRadius="4"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource BrandBrush}"
                                   Text="&#xE765;" />
                        <TextBlock x:Name="CaptureNoticeText" Grid.Column="1"
                                   Foreground="{DynamicResource BrandBrush}"
                                   Text="请按下包含 Ctrl、Alt、Shift 或 Win 的组合键；Esc 取消，Backspace 清除。" />
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding GroupedHotKeys}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitleStyle}"
                                                               Text="{Binding Name}" />
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6">
                                                        <ItemsPresenter />
                                                    </Border>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="210" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding ActionName}" />
                                        <TextBlock Margin="0,4,20,0"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" MinHeight="36" Padding="10,5"
                                            Tag="{Binding}" IsEnabled="{Binding CanEdit}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CaptureShortcutButton_OnClick"
                                            ToolTip="点击后录入新的组合键">
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding Shortcut}" />
                                    </Button>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="可用">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="冲突">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="录入中">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                                            Tag="{Binding}" IsEnabled="{Binding CanEdit}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ClearShortcutButton_OnClick"
                                            ToolTip="清除快捷键">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Text="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
