<UserControl x:Class="MoniHop.Desktop.Views.HotKeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="快捷键" />
        <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}" Text="每个动作使用一个独立快捷键，并单独显示注册或执行状态。" />
        <Border Style="{StaticResource SurfaceSectionStyle}"><ItemsControl ItemsSource="{Binding HotKeys}">
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Padding="0,13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ActionName}"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" Padding="10,6" Background="{StaticResource SurfaceSecondaryBrush}" CornerRadius="4"><TextBlock Text="{Binding Shortcut}"/></Border>
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrandBrush}" Text="{Binding Status}"/>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl></Border>
        <Border Margin="0,18,0,0" Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="后续快捷键" />
            <TextBlock Margin="0,0,0,12" Style="{StaticResource SecondaryTextStyle}" Text="指定显示器投放、窗口与鼠标组合切屏、窗口召回将在后续功能切片实现。" />
            <TextBlock Foreground="{StaticResource DisabledBrush}" Text="待开发 · 当前不可配置" />
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
