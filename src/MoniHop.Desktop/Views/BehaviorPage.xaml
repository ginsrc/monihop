<UserControl x:Class="MoniHop.Desktop.Views.BehaviorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,0" MaxWidth="960">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{DynamicResource String.GeneralSettings}" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource PageSubtitleStyle}"
                       Text="{DynamicResource String.GeneralSettings.Description}" />

            <Border Style="{StaticResource SurfaceSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource String.General.Startup.Section}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Startup.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Startup.Description}" />
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="StartWithWindowsToggle_OnClick" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Close.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Close.Description}" />
                        </StackPanel>
                        <ComboBox x:Name="CloseBehaviorComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  SelectionChanged="CloseBehaviorComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{DynamicResource String.General.Close.Ask}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Close.Tray}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Close.Exit}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource SecondaryTextStyle}"
                               Text="{DynamicResource String.General.Tray.Dependency}" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource String.General.Interaction.Section}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Cursor.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Cursor.Description}" />
                        </StackPanel>
                        <ComboBox x:Name="CursorLandingComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  SelectionChanged="CursorLandingComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{DynamicResource String.General.Cursor.Relative}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Cursor.Center}" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Recall.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Recall.Description}" />
                        </StackPanel>
                        <CheckBox x:Name="RecallOffscreenToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="RecallOffscreenToggle_OnClick" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Success.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Success.Description}" />
                        </StackPanel>
                        <CheckBox x:Name="SuccessNotificationsToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="SuccessNotificationsToggle_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource String.General.Permission.Section}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Permission.Current}" />
                            <TextBlock x:Name="PermissionStatusText" Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Button x:Name="RestartElevatedButton" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource String.General.Permission.Restart}" Click="RestartElevatedButton_OnClick" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Permission.Always}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Permission.AlwaysDescription}" />
                        </StackPanel>
                        <CheckBox x:Name="AlwaysAdminToggle" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" Click="AlwaysAdminToggle_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Style="{StaticResource SurfaceSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{DynamicResource String.General.Personalization.Section}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Theme.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Theme.Description}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  SelectionChanged="ThemeComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{DynamicResource String.General.Theme.System}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Theme.Light}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Theme.Dark}" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource String.General.Language.Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{DynamicResource String.General.Language.Description}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" VerticalAlignment="Center"
                                  SelectionChanged="LanguageComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="{DynamicResource String.General.Language.System}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Language.Chinese}" />
                            <ComboBoxItem Content="{DynamicResource String.General.Language.English}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="2,12,0,4" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
