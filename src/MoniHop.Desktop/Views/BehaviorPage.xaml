<UserControl x:Class="MoniHop.Desktop.Views.BehaviorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="行为与恢复" />
        <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}" Text="管理鼠标落点、断屏恢复和程序启动行为。所有选项默认关闭。" />
        <Border Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="鼠标切屏行为" />
            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="切换后的鼠标位置"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="当前实现按显示器相对位置移动；位置偏好配置待开发。"/></StackPanel><ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="保持相对位置"/><ComboBoxItem Content="目标显示器中心"/><ComboBoxItem Content="记忆上次位置"/></ComboBox></Grid>
        </StackPanel></Border>
        <Border Margin="0,18,0,0" Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="恢复与启动" />
            <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="断屏自动召回"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="用于 Windows 未正确处理的屏幕外窗口，默认关闭。"/></StackPanel><CheckBox Grid.Column="1" IsEnabled="False" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
            <Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="开机启动"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="随 Windows 登录启动 MoniHop，默认关闭。"/></StackPanel><CheckBox Grid.Column="1" IsEnabled="False" Style="{StaticResource ToggleSwitchStyle}"/></Grid>
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource DisabledBrush}" Text="待开发 · 当前设置不会写入系统" />
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
