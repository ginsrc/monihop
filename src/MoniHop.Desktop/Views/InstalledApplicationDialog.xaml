<Window x:Class="MoniHop.Desktop.Views.InstalledApplicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择已安装应用" Width="560" Height="500" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="19" FontWeight="SemiBold" Text="选择已安装应用" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}"
                   Text="从 Windows 应用列表选择；桌面应用和 Microsoft Store 应用均可建立规则。" />
        <ListBox x:Name="ApplicationsList" Grid.Row="3" ItemsSource="{Binding Applications}"
                 MouseDoubleClick="ApplicationsList_OnMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                        <TextBlock Grid.Row="1" Margin="0,3,0,0" FontSize="12" Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding Identity.Value}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="78" Margin="0,0,8,0" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="78" Content="选择" IsDefault="True" Click="Select_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
