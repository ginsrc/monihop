<UserControl x:Class="MoniHop.Desktop.Views.DisplaysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="显示器" />
            <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}"
                       Text="查看当前系统识别到的显示器及基础信息。" />

            <Border Style="{StaticResource SurfaceSectionStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当前显示器" />
                    <ItemsControl ItemsSource="{Binding Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190" Height="112" Margin="6" Padding="16"
                                        Background="{StaticResource BrandSubtleBrush}"
                                        BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ScreenLabel}" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Name}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{Binding PrimaryStatus}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,24,0,10" Style="{StaticResource SectionTitleStyle}" Text="显示器列表" />
            <TextBlock Margin="0,0,0,12" Style="{StaticResource SecondaryTextStyle}"
                       Text="列出当前已识别的显示器；历史记录和自定义名称将在后续功能切片接入。" />
            <ListView ItemsSource="{Binding Displays}" MinHeight="150">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="显示器名称" Width="120" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="属性" Width="110" DisplayMemberBinding="{Binding PrimaryStatus}" />
                        <GridViewColumn Header="分辨率" Width="105" DisplayMemberBinding="{Binding Resolution}" />
                        <GridViewColumn Header="刷新率" Width="70"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="待识别" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="缩放" Width="55"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="待识别" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="方向" Width="55"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="待识别" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="尺寸" Width="55"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="待识别" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="应用规则" Width="75"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="待开发" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="状态" Width="60"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Foreground="{StaticResource SuccessBrush}" Text="已识别" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        <GridViewColumn Header="操作" Width="80"><GridViewColumn.CellTemplate><DataTemplate><Button Content="重命名" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}" ToolTip="显示器命名将在后续功能切片接入" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
