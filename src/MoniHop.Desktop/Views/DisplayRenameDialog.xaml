<Window x:Class="MoniHop.Desktop.Views.DisplayRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名显示器" Width="420" Height="190" MinWidth="360" MinHeight="170"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="显示器名称" />
        <TextBox x:Name="NameTextBox" Grid.Row="2" MinHeight="34" Padding="8,5" />
        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="76" Margin="0,0,8,0" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Width="76" Content="保存" IsDefault="True" Click="Save_OnClick" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
