<UserControl x:Class="MoniHop.Desktop.Views.ProjectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="窗口投放" />
        <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}" Text="临时移动当前窗口，不改变应用的长期打开规则。" />
        <Border Style="{StaticResource SurfaceSectionStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="快捷键投放" />
                <TextBlock Margin="0,0,0,14" Style="{StaticResource SecondaryTextStyle}" Text="当前窗口切换到上一屏或下一屏已接入；每项快捷键独立显示。" />
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="当前窗口移到上一屏"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Ctrl + Alt + Shift + Left"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource SuccessBrush}" Text="已接入"/></Grid>
                <Grid Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="当前窗口移到下一屏"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Ctrl + Alt + Shift + Right"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource SuccessBrush}" Text="已接入"/></Grid>
            </StackPanel>
        </Border>
        <Border Margin="0,18,0,0" Style="{StaticResource SurfaceSectionStyle}">
            <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="顶部投放层"/><TextBlock Margin="0,0,0,14" Style="{StaticResource SecondaryTextStyle}" Text="伴随式投放层、固定位置和自由拖动三种模式已完成方向确认，系统运行能力尚未接入。"/><CheckBox Content="启用顶部投放层" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False"/><TextBlock Margin="0,12,0,0" Foreground="{StaticResource DisabledBrush}" Text="待开发 · 当前不可用"/></StackPanel>
        </Border>
    </StackPanel></ScrollViewer>
</UserControl>
