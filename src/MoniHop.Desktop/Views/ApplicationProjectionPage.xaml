<UserControl x:Class="MoniHop.Desktop.Views.ApplicationProjectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ProjectionComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectionComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProjectionComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="12,0,4,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons" FontSize="12" Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#AAB5C4" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="3"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=ComboRoot}" MaxHeight="280" Padding="3"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,16,0" MaxWidth="980">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="应用投放" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource PageSubtitleStyle}"
                               Text="决定新窗口默认在哪块显示器打开，并为指定应用设置覆盖规则。" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,20,0,8" Style="{StaticResource SectionTitleStyle}"
                           Text="全局投放规则" />

                <Border Grid.Row="2" Style="{StaticResource SurfaceSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="新窗口自动投放" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="关闭时保留全部规则，并使用 Windows 或应用原有行为。" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ProjectionEnabledStateText" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}" Text="已关闭" />
                            <CheckBox x:Name="ProjectionEnabledToggle" Style="{StaticResource ToggleSwitchStyle}"
                                      AutomationProperties.Name="新窗口自动投放"
                                      Checked="ProjectionEnabledToggle_OnChanged" Unchecked="ProjectionEnabledToggle_OnChanged" />
                        </StackPanel>

                        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="默认打开显示器" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="未命中应用专属规则时使用；默认跟随 Windows 主显示器。" />
                        </StackPanel>
                        <ComboBox x:Name="DefaultTargetComboBox" Grid.Row="2" Grid.Column="2"
                                  Style="{StaticResource ProjectionComboBoxStyle}" VerticalAlignment="Center"
                                  ItemsSource="{Binding GlobalTargets}"
                                  SelectionChanged="DefaultTargetComboBox_OnSelectionChanged" />
                    </Grid>
                </Border>

                <Border x:Name="MissingTargetNotice" Grid.Row="3" Margin="0,8,0,0" Padding="12,9"
                        Background="{DynamicResource WarningSubtleBrush}" CornerRadius="4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource WarningBrush}" Text="&#xE7BA;" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource WarningBrush}"
                                   Text="默认目标或应用规则引用的显示器暂不可用；配置会保留，重新连接后自动匹配。" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,20,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Text="应用专属规则" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="选择运行中的应用"
                                Click="RunningAppButton_OnClick" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="选择已安装应用"
                                Click="InstalledAppButton_OnClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" MinHeight="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="350" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Padding="12,0" Background="{DynamicResource WindowBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="应用" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="目标显示器" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="打开布局" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="状态" />
                                </Grid>
                            </Border>
                            <ListView x:Name="RulesList" Grid.Row="1" ItemsSource="{Binding Rules}" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SelectionChanged="RulesList_OnSelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="MinHeight" Value="46" />
                                        <Setter Property="Margin" Value="6,4" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="RowBorder" Padding="{TemplateBinding Padding}"
                                                            Background="Transparent" BorderBrush="Transparent"
                                                            BorderThickness="1" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BrandSubtleBrush}" />
                                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#9DB9F4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding ApplicationName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TargetDisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LayoutName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding State}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource CardTitleStyle}" Text="还没有应用专属规则" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                           Text="从运行中的应用或已安装应用中添加。" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="18,16" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="规则详情" />
                            <TextBlock x:Name="SelectedRuleNameText" Grid.Row="1" Margin="0,4,0,0"
                                       Style="{StaticResource FieldLabelStyle}" Text="请选择一条规则" TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryTextStyle}"
                                           Text="目标显示器" />
                                <ComboBox x:Name="RuleTargetComboBox" Style="{StaticResource ProjectionComboBoxStyle}"
                                          ItemsSource="{Binding RuleTargets}"
                                          IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryTextStyle}"
                                           Text="打开布局" />
                                <ComboBox x:Name="LayoutComboBox" Style="{StaticResource ProjectionComboBoxStyle}"
                                          ItemsSource="{Binding Layouts}"
                                          IsEnabled="False" />
                            </StackPanel>
                            <Grid Grid.Row="4" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="启用此规则" />
                                    <TextBlock x:Name="RuleEnabledStateText" Margin="0,3,0,0"
                                               Style="{StaticResource SecondaryTextStyle}" Text="未选择" />
                                </StackPanel>
                                <CheckBox x:Name="RuleEnabledToggle" Grid.Column="1" VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False"
                                          Checked="RuleEnabledToggle_OnChanged" Unchecked="RuleEnabledToggle_OnChanged" />
                            </Grid>

                            <Border x:Name="RuleWarning" Grid.Row="6" Margin="0,12,0,0" Padding="10,8"
                                    Background="{DynamicResource WarningSubtleBrush}" CornerRadius="4" Visibility="Collapsed">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                           Text="目标暂不可用；请选择当前显示器后保存，或等待设备重新连接。" />
                            </Border>
                            <StackPanel Grid.Row="7" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="DeleteRuleButton" MinWidth="72" Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Foreground="{DynamicResource ErrorBrush}"
                                        Content="删除" IsEnabled="False" Click="DeleteRuleButton_OnClick" />
                                <Button x:Name="SaveRuleButton" MinWidth="72" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="保存" IsEnabled="False" Click="SaveRuleButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border x:Name="ActionToast" Panel.ZIndex="30" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,16,18" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastIndicator" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBrush}" />
                <TextBlock x:Name="ToastText" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
