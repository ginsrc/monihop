<UserControl x:Class="MoniHop.Desktop.Views.ApplicationProjectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="应用投放" />
        <TextBlock Margin="0,8,0,22" Style="{StaticResource SecondaryTextStyle}" Text="决定新窗口默认在哪块显示器打开，并为指定应用设置覆盖规则。" />
        <Border Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="默认打开显示器" />
            <TextBlock Margin="0,0,0,10" Style="{StaticResource SecondaryTextStyle}" Text="未命中应用专属规则时使用；正式配置能力将在后续切片接入。" />
            <ComboBox ItemsSource="{Binding DisplayTargets}" SelectedIndex="0" IsEnabled="False" />
            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource DisabledBrush}" Text="待开发 · 仅显示当前显示器目标" />
        </StackPanel></Border>
        <Border Margin="0,18,0,0" Style="{StaticResource SurfaceSectionStyle}"><StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="应用规则" />
            <TextBlock Margin="0,0,0,16" Style="{StaticResource SecondaryTextStyle}" Text="规则列表会使用稳定应用身份和显示器记录；当前尚未写入配置。" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="尚未添加应用规则"/><Button Grid.Column="1" Content="添加应用" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/></Grid>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
